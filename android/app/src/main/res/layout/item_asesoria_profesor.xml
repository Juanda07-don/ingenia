<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAsesoriaProfesorItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: Badge de Estado y Modalidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProfEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Agendada"
                android:textColor="#1E40AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvProfModalidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presencial"
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Materia -->
        <TextView
            android:id="@+id/tvProfMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cálculo integral"
            android:textColor="@color/ingenia_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Estudiante -->
        <TextView
            android:id="@+id/tvProfEstudiante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Estudiante: Valentina García"
            android:textColor="@color/ingenia_text_secondary"
            android:textSize="14sp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#F3F4F6" />

        <!-- Horario -->
        <TextView
            android:id="@+id/tvProfHorario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒  Lun. 5 oct. · 10:00–10:30"
            android:textColor="@color/ingenia_text_secondary"
            android:textSize="13sp" />

        <!-- Lugar -->
        <TextView
            android:id="@+id/tvProfLugar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍  Edificio A · Aula 204"
            android:textColor="@color/ingenia_text_secondary"
            android:textSize="13sp" />

        <!-- Botón Reprogramar de la tarjeta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReprogramarItem"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Reprogramar"
            android:textAllCaps="false"
            android:textColor="@color/ingenia_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/ingenia_primary"
            app:strokeWidth="1dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>