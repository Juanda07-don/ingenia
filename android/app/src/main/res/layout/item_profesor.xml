<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProfesor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Círculo con las iniciales (ej: LM) -->
        <TextView
            android:id="@+id/tvIniciales"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:text="LM"
            android:textColor="@color/ingenia_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Datos del profesor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreProfesor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dra. Laura Méndez"
                android:textColor="@color/ingenia_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMateriaProfesor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cálculo integral"
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvProximoHorario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="● Próximo: Hoy · 15:30"
                android:textColor="#059669"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flecha hacia la derecha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/ingenia_text_secondary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>