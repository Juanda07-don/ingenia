<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationProfesor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- HEADER SUPERIOR: Ingenia.  UAO · Vida universitaria -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ingenia."
                    android:textColor="@color/ingenia_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UAO · Vida universitaria"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SALUDO AL PROFESOR -->
            <TextView
                android:id="@+id/tvSaludoProfesor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Hola, Laura"
                android:textColor="@color/ingenia_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Qué bueno verte. Sigamos acompañando."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="14sp" />

            <!-- SECCIÓN: TU PRÓXIMA ATENCIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tu próxima atención"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFechaRelativaProfesor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Próxima"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- TARJETA DE LA PRÓXIMA ATENCIÓN (Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProximaAtencion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Badges: Estado y Modalidad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvBadgeEstadoProfesor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Agendada"
                            android:textColor="#1E40AF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Presencial"
                            android:textColor="@color/ingenia_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Materia -->
                    <TextView
                        android:id="@+id/tvMateriaProfesorCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Cálculo integral"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Estudiante -->
                    <TextView
                        android:id="@+id/tvEstudianteCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Estudiante: Valentina García"
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="14sp" />

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F3F4F6" />

                    <!-- Horario -->
                    <TextView
                        android:id="@+id/tvHorarioProfesorCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒  Lun. 5 oct. · 10:00–10:30"
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="13sp" />

                    <!-- Lugar -->
                    <TextView
                        android:id="@+id/tvLugarProfesorCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="📍  Edificio A · Aula 204"
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="13sp" />

                    <!-- Botón Reprogramar dentro de la tarjeta -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReprogramarCard"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="Reprogramar"
                        android:textAllCaps="false"
                        android:textColor="@color/ingenia_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/ingenia_primary"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MENSAJE SI NO TIENE ATENCIONES PENDIENTES -->
            <TextView
                android:id="@+id/tvSinAtenciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F9FAFB"
                android:gravity="center"
                android:padding="20dp"
                android:text="No tienes atenciones próximas agendadas."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- CONTADOR DE ASESORÍAS SEMANALES -->
            <TextView
                android:id="@+id/tvContadorSemanaProfesor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Asesorías agendadas"
                android:textColor="@color/ingenia_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Botón 1: Ver asesorías agendadas (sólido) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerAsesoriasAgendadas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Ver asesorías agendadas"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ingenia_primary"
                app:cornerRadius="12dp" />

            <!-- Botón 2: Configurar disponibilidad (outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfigurarDisponibilidad"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Configurar disponibilidad"
                android:textAllCaps="false"
                android:textColor="@color/ingenia_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/ingenia_primary"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRA INFERIOR DE NAVEGACIÓN -->
    <LinearLayout
        android:id="@+id/bottomNavigationProfesor"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab Inicio (Activo) -->
        <LinearLayout
            android:id="@+id/navInicioProfesor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="@color/ingenia_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab Agenda -->
        <LinearLayout
            android:id="@+id/navAgendaProfesor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tab Perfil -->
        <LinearLayout
            android:id="@+id/navPerfilProfesor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>