<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBotonContinuar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- HEADER SUPERIOR: Ingenia.  UAO · Vida universitaria -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ingenia."
                    android:textColor="@color/ingenia_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UAO · Vida universitaria"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- BOTÓN ATRÁS Y TÍTULO -->
            <LinearLayout
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←  "
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perfil del profesor"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elige uno de sus espacios disponibles."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="14sp" />

            <!-- TARJETA PERFIL DEL DOCENTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvInicialesDocente"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:text="LM"
                        android:textColor="@color/ingenia_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNombreDocente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dra. Laura Méndez"
                            android:textColor="@color/ingenia_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMateriasDocente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Cálculo integral · Cubículo 204"
                            android:textColor="@color/ingenia_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="● Presencial"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TÍTULO MES Y SEMANA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvMesAnio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Octubre 2026"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSemanaRango"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semana actual"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- SELECTOR DÍAS DE LA SEMANA (LUN - VIE) -->
            <LinearLayout
                android:id="@+id/layoutDiasSemana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Botón Lunes -->
                <LinearLayout
                    android:id="@+id/btnDiaLun"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/badge_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreDiaLun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lun."
                        android:textColor="@color/ingenia_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumeroDiaLun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26"
                        android:textColor="@color/ingenia_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Martes -->
                <LinearLayout
                    android:id="@+id/btnDiaMar"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreDiaMar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mar."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumeroDiaMar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="27"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Miércoles -->
                <LinearLayout
                    android:id="@+id/btnDiaMie"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreDiaMie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mié."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumeroDiaMie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Jueves -->
                <LinearLayout
                    android:id="@+id/btnDiaJue"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreDiaJue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jue."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumeroDiaJue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="29"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Viernes -->
                <LinearLayout
                    android:id="@+id/btnDiaVie"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreDiaVie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vie."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumeroDiaVie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- LEYENDA LIBRE / OCUPADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Libre"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="● Ocupado"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- MENSAJE VACÍO O DE CARGA -->
            <TextView
                android:id="@+id/tvMensajeDisponibilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#F9FAFB"
                android:gravity="center"
                android:padding="20dp"
                android:text="Consultando espacios disponibles..."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- LISTA DE HORARIOS (FRANJAS) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFranjas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRA INFERIOR CON EL BOTÓN "Continuar con este horario" -->
    <LinearLayout
        android:id="@+id/layoutBotonContinuar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="12dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarHorario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:enabled="false"
            android:text="Continuar con este horario"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ingenia_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>