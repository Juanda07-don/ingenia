<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- VISTA 1: FORMULARIO DE REPROGRAMACIÓN (Página 17 de Figma) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutFormularioReprogramar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- HEADER SUPERIOR: Ingenia.  UAO · Vida universitaria -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ingenia."
                    android:textColor="@color/ingenia_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UAO · Vida universitaria"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- BOTÓN ATRÁS Y TÍTULO -->
            <LinearLayout
                android:id="@+id/btnVolverReprogramar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←  "
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reprogramar asesoría"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elige un espacio libre para proponer el cambio."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="14sp" />

            <!-- SECCIÓN: ASESORÍA ACTUAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Asesoría actual"
                android:textColor="@color/ingenia_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#F9FAFB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvMateriaActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cálculo integral"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstudianteActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Estudiante: Valentina García"
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#E5E7EB" />

                    <TextView
                        android:id="@+id/tvHorarioActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒  Mar. 27 oct. · 09:15–09:30"
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLugarActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="📍  Edificio A · Cubículo 204"
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN: NUEVO HORARIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Nuevo horario"
                android:textColor="@color/ingenia_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- SELECTOR DÍAS DE LA SEMANA (LUN - VIE) -->
            <LinearLayout
                android:id="@+id/layoutDiasReprogramar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/btnReproLun"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/badge_bg"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReproLun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lun."
                        android:textColor="@color/ingenia_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumReproLun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26"
                        android:textColor="@color/ingenia_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnReproMar"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReproMar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mar."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumReproMar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="27"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnReproMie"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReproMie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mié."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumReproMie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnReproJue"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReproJue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jue."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumReproJue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="29"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnReproVie"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F3F4F6"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreReproVie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vie."
                        android:textColor="@color/ingenia_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNumReproVie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textColor="@color/ingenia_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- MENSAJE O LISTA DE FRANJAS -->
            <TextView
                android:id="@+id/tvMensajeEspaciosReprogramar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#F9FAFB"
                android:gravity="center"
                android:padding="16dp"
                android:text="Consultando espacios disponibles..."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFranjasReprogramar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- SECCIÓN: MOTIVO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Motivo (opcional)"
                android:textColor="@color/ingenia_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/ingenia_primary"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMotivoReprogramar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. Cambio de horario de clase"
                    android:inputType="text"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvHelperMotivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="El motivo se compartirá con Valentina."
                android:textColor="@color/ingenia_text_secondary"
                android:textSize="11sp" />

            <!-- BOTONES DE ACCIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarReprogramacion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:enabled="false"
                android:text="Enviar reprogramación"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/ingenia_primary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarReprogramacion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/ingenia_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/ingenia_primary"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- VISTA 2: PENDIENTE DE CONFIRMACIÓN (Página 18 de Figma - Oculta inicialmente) -->
    <LinearLayout
        android:id="@+id/layoutExitoReprogramar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <!-- Reloj Amarillo/Naranja -->
        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="#FEF3C7"
            android:gravity="center"
            android:text="🕒"
            android:textColor="#B45309"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Pendiente de confirmación"
            android:textColor="@color/ingenia_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloExitoRepro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Se notificó a Valentina García."
            android:textColor="@color/ingenia_text_secondary"
            android:textSize="14sp" />

        <!-- Card con los datos de la propuesta -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FEF3C7"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Enviada"
                    android:textColor="#B45309"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMateriaExitoRepro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cálculo integral"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstudianteExitoRepro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Estudiante: Valentina García"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F3F4F6" />

                <TextView
                    android:id="@+id/tvHorarioNuevoExitoRepro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒  Vie. 30 oct. · 10:00–10:30"
                    android:textColor="@color/ingenia_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHorarioAnteriorExitoRepro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Antes: mar. 27 oct., 09:15–09:30"
                    android:textColor="@color/ingenia_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Aviso al Estudiante -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FBF2F4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvMensajeAvisoEstudiante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔  Valentina recibió la propuesta de nuevo horario. Su aceptación está pendiente."
                    android:textColor="@color/ingenia_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón Volver a agenda -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverAgendaRepro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Volver a agenda"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ingenia_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>